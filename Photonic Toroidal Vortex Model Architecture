Attraction_mechanism:
  - proton_and_electron_Sp-3_have_opposite_rotations
  - proton_Sp-3_field_momentum_intrudes_in_electron_Sp-3_rotation
  - electron_Sp-3_action_reduced_by_field_momentum_so_toroid_attempts_to_find_next_lowest_integer_action
  - electron_seeks_stronger_proton_field_to_reduce_action_further
  - electron_Sp-3_energy_redistributed_into_translational_motion_towards_proton
  - translational_energy_emitted_as_radiation_at_bound-state_distance

Repulsion_mechanism:
  - same_charges_have_same_sense_Sp-3_rotations
  - action_in_target_Sp-3_is_overloaded_by_intruding_Sp-3_field_momentum
  - toroid_attempts_to_find_next_lowest_integer_action
  - toroid_seeks_weaker_source_field_to_reduce_action_further
  - Sp-3_energy_redistributed_into_translational_motion_away_from_source

Photon_and_toroid_interaction_mechanism:
  - ground-state_has_the_highest_Sp-2_frequency
  - as_n_increases_the frequency_decreases
  - photons_are_rotating_structures_(SAM_or_OAM)
  - if_the_photon_rotation_opposes_the_Sp-3_rotation_sense,_the_Sp-3_frequency_decreases
  - stimulated_emission:_for_n>1_if_the_photon_rotation_is_the_same_sense_as_the_Sp-3_rotation_sense,_the_Sp-3_frequency_increases,_with_emission_of_a_transition_photon_plus_the_incident_one

String_density:
  - in_the_Sommerfeld_model_the_orbital_radius_is_proportional_to_na^2
  - in_the_Photonic_Toroidal_Vortex_model_the_Sp-3_radius_r3o_is_invariant_and_all_states_reside_on_the_surface_of_a_guide_tube_with_radius_r3o
  - the_angular_momentum_change_is_handled_by having_the_number_of_strings_in_a_state_proportional_to_na^2

